<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- HUD text over video: bold, light green, dark shadow for any background. -->
    <style name="Hud">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">@string/hud_unknown</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#B8FFB0</item>
        <item name="android:shadowColor">#E0000000</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">3</item>
    </style>

    <!-- Headset HUD: one line at the top and the bottom of the HUD area;
         size and gaps set by HeadsetHudSizer. -->
    <style name="HudHeadset" parent="Hud">
        <item name="android:maxLines">1</item>
    </style>

    <!-- Warnings: centred lines in the warning colour. -->
    <style name="HudAlert" parent="Hud">
        <item name="android:text"></item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FF6040</item>
    </style>

    <!-- Settings screen rows: a full-width card, the setting and its value. -->
    <style name="SettingRow" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- A note under a setting. -->
    <style name="SettingNote">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Map screen: the zoom buttons over the preview, the centre choices under it. -->
    <style name="MapZoom" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/btn_map_zoom</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="MapCenterButton" parent="Button.Secondary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Lens calibration panel (headset view). -->
    <style name="LensRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="LensButton">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="LensValue" parent="Hud">
        <item name="android:minWidth">200dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
