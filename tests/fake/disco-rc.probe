# The Disco's RC receiver for a hobby radio (Rc feature, NOTES.md section
# 31): receiver state, channel monitoring, calibration (neutral, then each
# action's channel by its travel), inversion, enabling refused in flight
# and before calibration, and the radio taking control of the flight.
send Common.Common.AllStates
expect Receiver_state | State=DISCONNECTED
expect Calibration_state | Calibration_type=NONE
expect Channels_monitor_state | State=0
mark
ctrl rc connect sbus
expect Receiver_state | State=CONNECTED | Protocol='SBUS' | Enabled=0
# not calibrated: enabling refused
send Rc.Enable_receiver 1
expect Receiver_state | State=CONNECTED | Protocol='SBUS' | Enabled=0
mark
send Rc.Monitor_channels 1
expect Channels_monitor_state | State=1
ctrl rc ch 3 40
expect Channel_value | Id=3 | Action=INVALID | Value=40
send Rc.Monitor_channels 0
expect Channels_monitor_state | State=0
mark
# min/max before neutral: refused
send Rc.Start_calibration MIN_MAX ROLL SIGNED_AXIS
expect Calibration_state | Calibration_type=NONE
ctrl rc ch 3 0
send Rc.Start_calibration NEUTRAL INVALID INVALID
expect Calibration_state | Calibration_type=NEUTRAL
expect Calibration_type=NONE | Channel_action=INVALID | Required=ROLL|PITCH|GAZ|TAKE_CONTROL | Calibrated=0 | Neutral_calibrated=1
mark
# roll on channel 1, pitch on 2, gaz on 3, take control on 5: each by its travel
send Rc.Start_calibration MIN_MAX ROLL SIGNED_AXIS
expect Calibration_state | Calibration_type=MIN_MAX | Channel_action=ROLL
ctrl rc ch 1 -90
ctrl rc ch 1 95
expect Calibration_state | Calibration_type=NONE
ctrl rc ch 1 0
send Rc.Start_calibration MIN_MAX PITCH SIGNED_AXIS
ctrl rc ch 2 90
ctrl rc ch 2 -90
expect Calibration_state | Calibration_type=NONE
ctrl rc ch 2 0
send Rc.Start_calibration MIN_MAX GAZ SIGNED_AXIS
ctrl rc ch 3 -100
ctrl rc ch 3 100
expect Calibration_state | Calibration_type=NONE
ctrl rc ch 3 0
send Rc.Start_calibration MIN_MAX TAKE_CONTROL BISTABLE_BUTTON
ctrl rc ch 5 100
expect Calibration_state | Calibration_type=NONE
expect Channel_action_item | Action=TAKE_CONTROL
ctrl rc ch 5 -100
ctrl_expect "cal=0x" rc
mark
send Rc.Invert_channel PITCH 1
expect Channel_action_item | Action=PITCH | Supported_type=SIGNED_AXIS | Calibrated_type=SIGNED_AXIS | Inverted=1
# enabling refused in flight, then accepted on the ground
ctrl flying_state flying
send Rc.Enable_receiver 1
expect Receiver_state | State=CONNECTED | Protocol='SBUS' | Enabled=0
ctrl flying_state landed
send Rc.Enable_receiver 1
expect Receiver_state | State=CONNECTED | Protocol='SBUS' | Enabled=1
# the radio flies only with its take-control switch on
ctrl_expect piloting=0 disco
ctrl rc sticks 0 50 0 100
ctrl_expect piloting=1 disco
ctrl rc sticks 0 0 0 -100
ctrl_expect piloting=0 disco
mark
# the receiver lost: reported (no more piloting)
ctrl rc disconnect
expect Receiver_state | State=DISCONNECTED
