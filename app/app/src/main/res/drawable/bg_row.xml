<?xml version="1.0" encoding="utf-8"?>
<!-- A settings row: a quiet card, highlighted when pressed. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FF8C1A">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="#0FFFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#1FFFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
