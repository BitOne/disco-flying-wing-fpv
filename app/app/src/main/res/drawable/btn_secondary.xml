<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FF8C1A">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <stroke android:width="1.5dp" android:color="#33FFFFFF" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#14FF8C1A" />
                    <stroke android:width="1.5dp" android:color="@color/accent" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
