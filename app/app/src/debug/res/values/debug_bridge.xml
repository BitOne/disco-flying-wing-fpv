<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: reach a SkyController through the SDK's debug USB bridge
  (mux over TCP) instead of USB. The address and port are set by the build
  (app/build.gradle.kts, -PdebugBridgeAddress / -PdebugBridgePort; make app
  DEBUG_BRIDGE=<host>): by default 10.0.2.2:4321, the emulator's host, where
  fake-sc2 listens (make fake). The real USB path stays enabled.
-->
<resources>
    <bool name="gsdk_usb_debug_enabled">true</bool>
</resources>
