<?xml version="1.0" encoding="utf-8"?>
<!-- HUD of the flight view, over the video. Modes (HudMode): classic text
     readouts (left: flight data; right: systems), minimal (battery and home
     arrow), fighter (horizon and tapes), map (moving map, also shown over
     any mode with the controller's map button); warnings below the centre in
     every mode; a banner names the mode when it changes. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hud"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/hud_classic"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <TextView android:id="@+id/hud_state" style="@style/Hud" />
            <TextView android:id="@+id/hud_altitude" style="@style/Hud" />
            <TextView android:id="@+id/hud_air_speed" style="@style/Hud" />
            <TextView android:id="@+id/hud_ground_speed" style="@style/Hud" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_margin="16dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView android:id="@+id/hud_battery" style="@style/Hud" />
            <TextView android:id="@+id/hud_rc_battery" style="@style/Hud" />
            <TextView android:id="@+id/hud_link" style="@style/Hud" />
            <TextView android:id="@+id/hud_record" style="@style/Hud" />
            <TextView android:id="@+id/hud_wind" style="@style/Hud" />
            <TextView android:id="@+id/hud_home_eta" style="@style/Hud" />
            <TextView android:id="@+id/hud_gps" style="@style/Hud" />
            <TextView android:id="@+id/hud_camera" style="@style/Hud" />
        </LinearLayout>
    </FrameLayout>

    <io.github.bitone.discofpv.MinimalHudView
        android:id="@+id/hud_minimal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <io.github.bitone.discofpv.FighterHudView
        android:id="@+id/hud_fighter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <io.github.bitone.discofpv.MapHudView
        android:id="@+id/hud_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- warnings (alarms, GPS lost, last fix), in every mode -->
    <!-- where the centred view is when the camera looks elsewhere -->
    <io.github.bitone.discofpv.CenterIndicatorView
        android:id="@+id/hud_center"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/hud_alerts"
        style="@style/HudAlert"
        android:layout_gravity="center"
        android:layout_marginTop="120dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hud_mode_banner"
        style="@style/Hud"
        android:layout_gravity="center"
        android:textSize="28sp"
        android:visibility="gone" />
</FrameLayout>
