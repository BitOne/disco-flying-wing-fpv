<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: grouped rows, each showing its setting and value; a tap changes it. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Title"
            android:text="@string/settings" />

        <TextView
            style="@style/Section"
            android:text="@string/section_controller" />
        <Button android:id="@+id/setting_map_button" style="@style/SettingRow" />
        <Button android:id="@+id/setting_map_hold" style="@style/SettingRow" />
        <Button android:id="@+id/setting_recenter_button" style="@style/SettingRow" />

        <TextView
            style="@style/Section"
            android:text="@string/section_headset" />
        <Button android:id="@+id/setting_hud_size" style="@style/SettingRow" />
        <Button android:id="@+id/setting_head_tracking" style="@style/SettingRow" />

        <TextView
            style="@style/Section"
            android:text="@string/section_map" />
        <!-- background, preview and offline download: the map screen -->
        <Button
            android:id="@+id/setting_map"
            style="@style/SettingRow"
            android:drawableEnd="@drawable/ic_chevron"
            android:drawablePadding="8dp" />

        <TextView
            style="@style/Section"
            android:text="@string/section_last_position" />
        <Button android:id="@+id/setting_last_fix" style="@style/SettingRow" />

        <TextView
            android:id="@+id/setting_last_fix_value"
            style="@style/SettingNote"
            android:textColor="@color/camera"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/setting_forget_fix"
            style="@style/SettingRow"
            android:text="@string/forget_last_fix" />
    </LinearLayout>
</ScrollView>
