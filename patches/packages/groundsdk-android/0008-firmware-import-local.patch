diff --git a/groundsdk/src/main/java/com/parrot/drone/groundsdk/internal/engine/firmware/FirmwareStoreCore.java b/groundsdk/src/main/java/com/parrot/drone/groundsdk/internal/engine/firmware/FirmwareStoreCore.java
--- a/groundsdk/src/main/java/com/parrot/drone/groundsdk/internal/engine/firmware/FirmwareStoreCore.java
+++ b/groundsdk/src/main/java/com/parrot/drone/groundsdk/internal/engine/firmware/FirmwareStoreCore.java
@@ -290,6 +290,47 @@
      * @return {@code true} if an existing local file URI was detached from the identified entry, otherwise
      *         {@code false}
      */
+    /**
+     * Disco FPV: a firmware update file provided by the application, made
+     * available locally (an entry is created if the store has none).
+     *
+     * @param firmware identifies the firmware the file contains
+     * @param file     the update file
+     *
+     * @return {@code true} if registered
+     */
+    boolean importLocalFirmware(@NonNull FirmwareIdentifier firmware, @NonNull File file) {
+        if (!file.isFile()) {
+            return false;
+        }
+        String md5;
+        try (InputStream in = new java.io.FileInputStream(file)) {
+            java.security.MessageDigest digest = java.security.MessageDigest.getInstance("MD5");
+            byte[] buffer = new byte[65536];
+            int n;
+            while ((n = in.read(buffer)) > 0) {
+                digest.update(buffer, 0, n);
+            }
+            StringBuilder hex = new StringBuilder();
+            for (byte b : digest.digest()) {
+                hex.append(String.format(java.util.Locale.ROOT, "%02x", b));
+            }
+            md5 = hex.toString();
+        } catch (java.io.IOException | java.security.NoSuchAlgorithmException e) {
+            ULog.w(TAG_FIRMWARE, "Could not read firmware file " + file, e);
+            return false;
+        }
+        FirmwareStoreEntry entry = mUpdates.get(firmware);
+        if (entry == null) {
+            mUpdates.put(firmware, new FirmwareStoreEntry(new FirmwareInfoCore(firmware, file.length(), md5,
+                    EnumSet.noneOf(FirmwareInfo.Attribute.class)), file.toURI(), null, null, null, false));
+        } else {
+            entry.setUri(file.toURI());
+        }
+        storeChanged();
+        return true;
+    }
+
     boolean deleteLocalFirmware(@NonNull FirmwareIdentifier firmware) {
         FirmwareStoreEntry toDelete = mUpdates.get(firmware);
         URI localUri = toDelete == null ? null : toDelete.getLocalUri();
