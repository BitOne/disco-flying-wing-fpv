<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- From the groundsdk AAR (2020, pre-Android 12): Android starts it when
             a SkyController is plugged in (USB_ACCESSORY_ATTACHED), so it must be
             exported; target 31+ requires saying so explicitly. -->
        <activity
            android:name="com.parrot.drone.groundsdk.internal.RcAccessoryBootstrapActivity"
            android:exported="true"
            tools:node="merge" />

        <activity
            android:name=".FlightActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <activity
            android:name=".HeadsetActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".RcActivity"
            android:exported="false" />

        <!-- singleTop, not singleTask: the launcher icon must bring back the
             flight or headset view the pilot was on, not clear it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
